# Copy to .env and fill in what you need:  cp .env.example .env
# .env is ignored by Git. Never commit API keys.
#
# Read by both docker compose (automatically, from the repository root) and the backend
# (spring.config.import in application.properties). Real environment variables win over this file.
#
# Format: KEY=value, one per line. No quotes and no "export": the backend reads the file as
# Java properties, so quotes would become part of the value.

# Gemini API key from Google AI Studio. Leave empty to use only the rule-based fake advisor.
GEMINI_API_KEY=

# true: give each newly imported run a one-line AI review right after an import (#36). Off by default,
# since it sends every new run to the AI. The detailed review is always asked for on the run's page.
RUNBUDDY_AI_AUTO_REVIEW=false
# Gemini models, comma separated. The first is the default and reviews runs. Leave it commented out
# for the built-in default (an empty value would leave no model). Change it when Google retires a
# model (the error then says "no longer available").
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Where the dashboard's "Garminから取り込む" reads runs: dummy (generated, the default) or garmin.
RUNBUDDY_ACTIVITY_SOURCE=dummy

# Garmin Connect Personal API key, needed when RUNBUDDY_ACTIVITY_SOURCE=garmin. Create one on the
# "Personal API Key" page of Garmin Connect Web; it is shown only once and expires (30 days to a year).
GARMIN_API_KEY=

# Host port of the local PostgreSQL. Change it when 5432 is taken by something else.
RUNBUDDY_DB_PORT=5432

# Log level of run-buddy's own classes: INFO (default) or DEBUG for Garmin's per-page requests.
RUNBUDDY_LOG_LEVEL=INFO

# Address the backend listens on. 127.0.0.1 (default) keeps it to this machine; Tailscale Serve
# still reaches it. Only change it if you know who else can reach this network.
RUNBUDDY_BIND_ADDRESS=127.0.0.1
